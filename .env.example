# For new installations see docs/setup.md; VM examples are in docs/env-guide.md.
# Copy to .env. Environment variables take precedence. Never commit actual secrets.
APP_HOST=127.0.0.1
IMPORT_PORT=8100
QUERY_PORT=8101
PLATFORM_PORT=8105
CORS_ORIGINS=http://127.0.0.1:8105,http://localhost:8105,http://127.0.0.1:5186,http://localhost:5186
# Generate locally with scripts/init_stage2.py. Never use an example secret.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
DATA_DIR=var/data
UPLOAD_MAX_MB=50
SERVICE_TIMEOUT_SECONDS=5
MODEL_TIMEOUT_SECONDS=60

# Fill in your own OpenAI-compatible chat endpoint/model/key.
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0
ITEM_MODEL=
# Independent OpenAI-compatible vision provider. Fill its own key.
VL_BASE_URL=https://ai.xmiaom.com/v1
VL_API_KEY=
VL_MODEL=

# Remote dense embedding. Empty URL/key reuse RERANK_BASE_URL/API_KEY.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=4096
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_TOKEN=
MINERU_POLL_TIMEOUT_SECONDS=300
RERANK_BASE_URL=https://emrank.tech/v1
RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
WEB_SEARCH_ENABLED=false
MCP_DASHSCOPE_BASE_URL=
MCP_API_KEY=

# Dedicated baseline namespaces. Do not point tests at production collections.
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
CHUNKS_COLLECTION=kb_stage1_chunks
ITEM_NAME_COLLECTION=kb_stage1_items
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=kb-stage1
MINIO_IMG_DIR=upload-images
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
MONGO_URL=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=kb_stage1

# MySQL business database; Alembic migrations run explicitly, never on API startup.
MYSQL_URL=mysql+pymysql://127.0.0.1:3306/kb_platform
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# Stage 4 private storage and independent durable import worker.
# Empty reuses configured private MINIO_BUCKET_NAME with UUID-scoped units/ keys.
KNOWLEDGE_BUCKET=
KNOWLEDGE_CHUNKS_COLLECTION=kb_platform_chunks_v1
IMPORT_CONCURRENCY=1
IMPORT_LEASE_SECONDS=90
IMPORT_HEARTBEAT_SECONDS=15
IMPORT_TASK_TIMEOUT_SECONDS=900
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETRY_BASE_SECONDS=15
IMPORT_POLL_SECONDS=2
IMPORT_MAX_FILES=100
IMPORT_BATCH_MAX_MB=200
IMPORT_EXPANDED_MAX_MB=200
IMPORT_MAX_PAGES=500
IMPORT_MAX_IMAGES=100
IMPORT_MAX_TEXT_CHARS=2000000
IMPORT_CHUNK_SIZE=800
IMPORT_CHUNK_OVERLAP=80
IMPORT_EMBEDDING_BATCH_SIZE=8
# Scanned PDFs fail explicitly unless OCR is enabled and MINERU_TOKEN configured.
IMPORT_PDF_OCR=false
# Embedded images are retained privately; optional summaries call the real VL provider.
IMPORT_IMAGE_SUMMARIES=false

# Stage 5 general RAG. Authorization uses current MySQL state on every model boundary.
RAG_REWRITE_ENABLED=true
RAG_HYDE_ENABLED=false
RAG_DENSE_LIMIT=24
RAG_DENSE_MAX_LIMIT=96
RAG_DENSE_BATCH_SIZE=200
RAG_LEXICAL_LIMIT=40
RAG_LEXICAL_SCAN_LIMIT=2000
RAG_RRF_K=60
RAG_RERANK_LIMIT=12
RAG_FINAL_LIMIT=6
RAG_DENSE_MIN_SCORE=0.35
RAG_RERANK_MIN_SCORE=0.2
RAG_LEXICAL_MIN_SCORE=0.1
RAG_CONTEXT_MAX_CHARS=14000
RAG_HISTORY_MAX_CHARS=6000
RAG_QUESTION_MAX_CHARS=2000
RAG_GENERATION_MAX_TOKENS=1600
RAG_STREAM_CHUNK_CHARS=80

# FAQ mining uses current source grants and real embeddings; exact fallback is disclosed.
FAQ_MIN_FREQUENCY=3
FAQ_MINING_SIMILARITY=0.92
SETTLEMENT_WINDOW_DAYS=30
SETTLEMENT_MAX_LOGS=5000
SETTLEMENT_INTERVAL_SECONDS=300
FAQ_CACHE_TTL_SECONDS=3600
FAQ_CACHE_PREFIX=kb-platform:faq:v1:
